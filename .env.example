# Security Guard Environment Configuration Template

# Server Port and Encryption Secret
PORT=5000
ENCRYPTION_SECRET=security-guard-32-byte-secure-secret-key!

# Google OAuth 2.0 Configuration (for Gmail provider)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/settings

# Microsoft Azure Entra ID Configuration (for Outlook provider)
MICROSOFT_CLIENT_ID=your-microsoft-app-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-app-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:5173/settings

# Optional Database Persistence (PostgreSQL / Drizzle)
# DATABASE_URL=postgresql://user:password@localhost:5432/security_guard
